// Auto-generated by Hibiki UI Settings
output "DP-1" {
    scale 1.00
}

output "HDMI-A-1" {
    scale 1.00
}

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle"
        }
        track-layout "global"
    }
    mouse {
        accel-speed 0.00
        accel-profile "flat"
    }
}

layout {
    gaps 8
    center-focused-column "never"
    shadow { on; }
    focus-ring {
        width 2
        active-gradient from="#a6e3e9" to="#89dceb" angle=45
    }
}

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}
